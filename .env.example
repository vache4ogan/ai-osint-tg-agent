# Пример файла конфигурации.
# Скопируйте этот файл в .env и укажите свои значения:
# cp .env.example .env

# Токен вашего Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxyz

# Ваш Telegram ID (чтобы только вы могли управлять ботом)
ADMIN_ID=123456789

# ID канала, куда бот будет публиковать готовые посты
CHANNEL_ID=-1001234567890

# Опционально: URL к Ollama (если она запущена не локально)
# В docker-compose этот параметр переопределяется автоматически.
OLLAMA_BASE_URL=http://localhost:11434
